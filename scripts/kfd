#!/usr/bin/env bash
# Family Hub control script for macOS/Linux.  Usage: scripts/kfd setup|start|stop|restart|status|health|run|smoke
# Everything stays under the repository's data/ directory unless KFD_* variables say otherwise.
set -euo pipefail
cd "$(dirname "$0")/.."
ROOT="$PWD"
DATA="${KFD_DATA_DIR:-$ROOT/data}"
VENV="$ROOT/.venv"
PY="$VENV/bin/python"
PIDFILE="$DATA/server.pid"
LOGFILE="$DATA/server.log"
ENVFILE="${KFD_ENV_FILE:-$DATA/kfd.env}"

load_env() {
  if [ -f "$ENVFILE" ]; then set -a; . "$ENVFILE"; set +a; fi
  export KFD_DB="${KFD_DB:-$DATA/family.sqlite3}"
  export KFD_PORT="${KFD_PORT:-8765}"
}

need_venv() { [ -x "$PY" ] || { echo "Run scripts/kfd setup first." >&2; exit 1; }; }

running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

cmd_setup() {
  command -v python3 >/dev/null || { echo "python3 not found (3.11 or newer needed)." >&2; exit 1; }
  python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' ||
    { echo "Python 3.11 or newer is required; found $(python3 --version)." >&2; exit 1; }
  [ -d "$VENV" ] || python3 -m venv "$VENV"
  "$PY" -m pip install --quiet --upgrade pip
  "$PY" -m pip install --quiet -r requirements.txt
  mkdir -p "$DATA"; chmod 700 "$DATA"
  load_env
  "$PY" -m app.manage init-db
  echo "Setup complete. Next: add members with: $PY -m app.manage add-user NAME   (then scripts/kfd start)"
}

cmd_start() {
  need_venv; load_env
  mkdir -p "$DATA"
  if running; then echo "Already running (pid $(cat "$PIDFILE"))."; return 0; fi
  nohup "$PY" -m app.server >>"$LOGFILE" 2>&1 &
  echo $! >"$PIDFILE"; chmod 600 "$PIDFILE"
  for _ in $(seq 1 30); do
    if cmd_health >/dev/null 2>&1; then echo "Started (pid $(cat "$PIDFILE")), http://127.0.0.1:$KFD_PORT"; return 0; fi
    running || { echo "Server exited during start-up. See $LOGFILE" >&2; rm -f "$PIDFILE"; exit 1; }
    sleep 0.5
  done
  echo "Server did not become healthy. See $LOGFILE" >&2; exit 1
}

cmd_stop() {
  if ! running; then echo "Not running."; rm -f "$PIDFILE"; return 0; fi
  pid="$(cat "$PIDFILE")"; kill "$pid"
  for _ in $(seq 1 40); do kill -0 "$pid" 2>/dev/null || { rm -f "$PIDFILE"; echo "Stopped."; return 0; }; sleep 0.25; done
  echo "Server did not stop within 10 seconds (pid $pid)." >&2; exit 1
}

cmd_health() {
  need_venv; load_env
  "$PY" - <<PYEOF
import json, sys, urllib.request
try:
    with urllib.request.urlopen('http://127.0.0.1:${KFD_PORT}/healthz', timeout=3) as r:
        ok = r.status == 200 and json.load(r)['ok'] is True
except Exception:
    ok = False
print('healthy' if ok else 'unhealthy')
sys.exit(0 if ok else 1)
PYEOF
}

cmd_status() {
  load_env
  if running; then echo "running (pid $(cat "$PIDFILE")), port $KFD_PORT"; cmd_health; else echo "stopped"; exit 3; fi
}

case "${1:-}" in
  setup) cmd_setup ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_stop; cmd_start ;;
  status) cmd_status ;;
  health) cmd_health ;;
  run) need_venv; load_env; exec "$PY" -m app.server ;;
  smoke) need_venv; exec "$PY" scripts/smoke.py ;;
  *) echo "Usage: scripts/kfd setup|start|stop|restart|status|health|run|smoke" >&2; exit 2 ;;
esac
