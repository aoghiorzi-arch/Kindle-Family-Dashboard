# Copy to data/kfd.env (kept out of Git). Loaded by scripts/kfd. No secrets belong in this file.
# Database and the separate calendar key. Keep the key on different storage from backups.
#KFD_DB=/path/to/family.sqlite3
#KFD_KEY_FILE=/path/to/protected/family.key
KFD_PORT=8765
# Set only when a TLS proxy fronts the app (see docs/NETWORK_PILOT.md). Enables Secure cookies, HSTS and strict Host/Origin checks.
#KFD_PUBLIC_ORIGIN=https://hub.home.arpa:8443
